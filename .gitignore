# ── Local-only planning doc ──────────────────────────────
PLAN.md

# ── Secrets ──────────────────────────────────────────────
.env
.env.*
!.env.example          # keep the template tracked
secrets/               # if you ever use Docker secret files

# ── Data (your DB + SQLite WAL sidecars) ─────────────────
data/
*.db
*.db-wal
*.db-shm

# ── Go (backend) ─────────────────────────────────────────
/api/server            # compiled binaries (go build output)
/api/mcp
/bin/
*.test                 # test binaries
*.out                  # coverage/profile output
coverage.*

# ── Rust (TUI) ───────────────────────────────────────────
tui/target/
target/

# ── Web (SvelteKit, once you add it) ─────────────────────
node_modules/
/web/build/
/web/.svelte-kit/
/web/dist/

# ── OS / editor junk ─────────────────────────────────────
.DS_Store
*.swp
*~
.idea/
# .vscode/             # uncomment to ignore, or keep for shared settings
